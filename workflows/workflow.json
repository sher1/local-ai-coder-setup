      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json.message?.content ?? '').trim();\nconst cleaned = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```$/, '').trim();\nlet plan;\ntry { plan = JSON.parse(cleaned); } catch (error) { throw new Error('Router did not return valid JSON: ' + raw); }\nif (!['coder', 'researcher', 'general'].includes(plan.target_worker)) throw new Error('Router returned an unsupported target_worker.');\nreturn [{ json: { task: $('Task Input').first().json.task, plan, retryCount: 0, retryFeedback: '' } }];"
      },
