      "parameters": {
        "jsCode": "const raw = String($json.message?.content ?? '').trim();\nconst cleaned = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```$/, '').trim();\nlet review;\ntry { review = JSON.parse(cleaned); } catch (error) { throw new Error('Verifier did not return valid JSON: ' + raw); }\nif (typeof review.passed !== 'boolean') throw new Error('Verifier response must contain a boolean passed field.');\nconst state = $('Prepare Verification Input').item.json;\nreturn [{ json: { ...state, passed: review.passed, feedback: String(review.feedback ?? '') } }];"
